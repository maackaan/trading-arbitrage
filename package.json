{
  "name": "trading-arbitrage",
  "private": true,
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "bash -lc 'cd backend && source .venv/bin/activate && uvicorn main:app --reload --host 127.0.0.1 --port 8000'",
    "dev": "sh -c 'trap \"kill $(jobs -p) 2>/dev/null\" EXIT INT TERM; npm run dev:backend & npm run dev:frontend & wait'",
    "frontend:dev": "npm run dev:frontend",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:lint": "npm --prefix frontend run lint",
    "backend:dev": "npm run dev:backend"
  }
}
