# Backend app settings
APP_NAME=CS2 Arbitrage API
ENVIRONMENT=dev
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./app.db

# Runtime behavior
USE_MOCK_PROVIDERS=true
MOCK_LISTINGS_ENABLED=false
MOCK_SEED=42
REFRESH_INTERVAL_SECONDS=10
LISTING_REFRESH_INTERVAL_SECONDS=8
DEFAULT_HISTORY_HOURS=72
SEARCH_CATALOG_PROVIDER=csgoskins_gg
SEARCH_CATALOG_URL=https://search.csgoskins.gg
SEARCH_CATALOG_KEY=6b86fad2efbfd796e2fdf50271b74a68374d7f750d3c19287ce89c0afa8e753d
SEARCH_CATALOG_TIMEOUT_SECONDS=8
SEARCH_CATALOG_FETCH_WEARS=true
CATALOG_IMAGE_REFRESH_TTL_SECONDS=21600
CSGOSKINS_PRICE_FALLBACK_ENABLED=false
CSGOSKINS_PRICE_TTL_SECONDS=180
CSGOSKINS_PRICE_RESOLVE_TTL_SECONDS=21600
CATALOG_IMAGE_CACHE_PATH=./skin_images_cache.json
CATALOG_PREFETCH_IMAGES=true

# Provider-specific rate limits (seconds): provider:value
PROVIDER_RATE_LIMITS=steam:5,buff_market:5,dmarket:5,skinbaron:5,buff163:5,csgofloat:5,skinsmonkey:5,skinport:5,csmoney:5

# Provider API keys/placeholders
STEAM_API_KEY=
BUFF_MARKET_API_KEY=
DMARKET_API_KEY=
SKINBARON_API_KEY=
BUFF163_API_KEY=
CSGOFLOAT_API_KEY=
SKINSMONKEY_API_KEY=
SKINPORT_API_KEY=
CSMONEY_API_KEY=
CSMONEY_LISTINGS_API_URL=
CSMONEY_API_TIMEOUT_SECONDS=10
